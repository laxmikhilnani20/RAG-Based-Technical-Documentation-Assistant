# ============================================================
# RAG-Based Technical Documentation Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git. Only commit .env.example.
# ============================================================


# ------------------------------------------------------------
# LLM Provider — Google Gemini
# Get your key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------
# Gemini Model Settings (defaults shown)
# ------------------------------------------------------------
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2


# ------------------------------------------------------------
# Vector Store — ChromaDB
# ------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=technical_docs


# ------------------------------------------------------------
# RAG Pipeline Settings
# ------------------------------------------------------------
RETRIEVAL_TOP_K=2
MAX_RETRY_ATTEMPTS=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ------------------------------------------------------------
# FastAPI App Settings
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development   # development | production



# ------------------------------------------------------------
# Hugging Face Deployment (set these as HF Space Secrets)
# These are NOT needed locally — only for HF Spaces
# ------------------------------------------------------------
# HF_SPACE_NAME=your-hf-username/rag-doc-assistant
